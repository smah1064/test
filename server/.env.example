# Copy to .env and edit.
PORT=3000
NODE_ENV=production
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Your company's time zone (IANA name). Used for dates, lateness and reports.
COMPANY_TZ=Asia/Riyadh

# First admin login (only used the first time the server starts). Change the password after logging in.
ADMIN_CODE=admin
ADMIN_PASSWORD=change-me-now

# Anti-cheat limits
MAX_GPS_ACCURACY_M=100
MAX_CAPTURE_AGE_SEC=300

# Monthly report email (optional). Report is always saved to data/reports/ too.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAILS=hr@yourcompany.com,manager@yourcompany.com
# When to generate last month's report (cron, company time zone). Default: 07:00 on the 1st.
REPORT_CRON=0 7 1 * *

# Where the database, selfies and reports are stored
# DATA_DIR=./data
