<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used once the app is signed with the shop's Apple account (the test builds aren't signed):
     shop links open the app (needs https://ebda3.me/.well-known/apple-app-site-association) and push notifications.
     With automatic signing, Xcode turns these on for the app id me.ebda3.app. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ebda3.me</string>
		<string>applinks:www.ebda3.me</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
