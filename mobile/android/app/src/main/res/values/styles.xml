<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The app's colours: the shop's background (#FAFAF7) everywhere, dark status-bar icons. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/shell_ink</item>
        <item name="colorPrimaryDark">@color/shell_background</item>
        <item name="colorAccent">@color/shell_accent</item>
        <item name="android:windowBackground">@color/shell_background</item>
    </style>

    <!-- Capacitor switches to this theme once the app has started. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Android 7–8.0 can't show dark navigation buttons, so the bar is dark there (values-v27: light). -->
        <item name="android:navigationBarColor">@color/shell_ink</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The launch screen (AndroidX SplashScreen, also on Android 7–11): the brand mark on the shop's background.
         MainActivity keeps it until the first page is on screen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/shell_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
