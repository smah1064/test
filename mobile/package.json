{
  "name": "ebda3-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "The إبداع (ebda3.me) shop as iPhone and Android apps: a Capacitor shell around the live site, with phone features.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/version.mjs sync && cap sync",
    "sync:android": "node scripts/version.mjs sync && cap sync android",
    "sync:ios": "node scripts/version.mjs sync && cap sync ios",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "assets": "node scripts/brand-assets.mjs",
    "version:show": "node scripts/version.mjs",
    "version:bump": "node scripts/version.mjs bump",
    "version:sync": "node scripts/version.mjs sync",
    "android:debug": "cd android && ./gradlew --no-daemon testDebugUnitTest assembleDebug",
    "android:release": "cd android && ./gradlew --no-daemon bundleRelease",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-app-update": "8.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  }
}
